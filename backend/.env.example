# Export through your approved env loader. Do NOT commit actual values.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Substitute local credentials. Production must use sslmode=require/verify-ca/verify-full.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/hostelspace?sslmode=prefer
